{
  "name": "@sigma-ui-kit/icons",
  "description": "Sigma UI Kit Icons",
  "version": "0.0.1",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./*": "./dist/*.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "author": "",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/sigma-ui-kit.git",
    "directory": "packages/icons"
  },
  "keywords": [
    "react",
    "ui",
    "icons",
    "sigma-ui-kit"
  ],
  "dependencies": {
    "@sigma-ui-kit/theme": "workspace:*"
  }
}
