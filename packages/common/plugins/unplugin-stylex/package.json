{
  "name": "@sigmaui-kit/unplugin-stylex",
  "version": "0.0.1",
  "description": "Unplugin for stylex",
  "keywords": [
    "unplugin",
    "stylex",
    "stylex-plugin",
    "farm",
    "esbuild",
    "rolldown",
    "rollup",
    "rspack",
    "svelte",
    "vite"
  ],
  "author": "",
  "license": "MIT",
  "main": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "yarn install",
    "build": "tsup src --dts && yarn generate:exports",
    "dev": "pnpm build:fast --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "build:fast": "tsup src",
    "prepack": "clean-package",
    "postpack": "clean-package restore",
    "prepublishOnly": "node ../../../../scripts/prepublish.js",
    "postpublish": "node ../../../../scripts/postpublish.js",
    "generate:exports": "node ./generate-exports.js"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "0.x"
  },
  "dependencies": {
    "@babel/core": "^7.27.1",
    "@babel/plugin-syntax-flow": "^7.27.1",
    "@babel/plugin-syntax-jsx": "^7.27.1",
    "@babel/plugin-syntax-typescript": "^7.27.1",
    "@rollup/pluginutils": "^5.1.4",
    "@stylexjs/babel-plugin": "^0.12.0",
    "unplugin": "^1.16.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.2",
    "@types/node": "^20.17.32",
    "@vitest/coverage-v8": "^3.1.2",
    "babel-plugin-syntax-hermes-parser": "^0.19.2",
    "jsr": "^0.13.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^3.1.2"
  }
}