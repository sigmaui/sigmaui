{
  "name": "@sigmaui-kit/icons",
  "version": "0.0.4",
  "description": "",
  "keywords": [],
  "author": "",
  "homepage": "https://sigmaui.org",
  "license": "MIT",
  "main": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigmaui/sigmaui.git",
    "directory": "packages/common/icons"
  },
  "scripts": {
    "setup": "yarn install",
    "build": "tsup src --dts && yarn generate:exports",
    "dev": "pnpm build:fast --watch",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "build:fast": "tsup src",
    "prepack": "clean-package",
    "postpack": "clean-package restore",
    "prepublishOnly": "node ../../../scripts/prepublish.js",
    "postpublish": "node ../../../scripts/postpublish.js",
    "generate:exports": "node ./generate-exports.js"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {},
  "clean-package": "./clean-package.config.json"
}