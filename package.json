{
  "name": "sigmaui",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "author": {
    "name": "",
    "email": ""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigmaui/sigmaui.git"
  },
  "scripts": {
    "dev": "turbo run dev --filter=sigmaui-org",
    "dev:web": "cd apps/website && yarn dev",
    "build": "turbo run build --filter=sigmaui-org",
    "build:web": "cd apps/website && yarn build",
    "serve": "turbo run serve --filter=sigmaui-org",
    "serve:web": "cd apps/website && yarn serve",
    "start": "yarn dev:web",
    "dev:docs": "cd apps/react-app/docs && yarn dev",
    "dev:dashboard": "cd apps/react-app/dashboard && yarn dev",
    "dev:chart-maker": "cd apps/react-app/chart-maker && yarn dev",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "husky",
    "commit": "npx git-cz",
    "prepare": "husky"
  },
  "dependencies": {
    "@microui-kit/box": "^1.1.0",
    "@microui-kit/create-renderer": "^1.1.5",
    "@microui-kit/fela-custom-renderer": "^1.0.1",
    "@microui-kit/fela-plugin-theme-value": "^1.1.2",
    "@microui-kit/loading": "^1.1.0",
    "@microui-kit/platform": "^1.1.3",
    "@microui-kit/provider": "^1.1.9",
    "@microui-kit/theme": "^1.1.8",
    "@microui-kit/types": "^1.1.8",
    "@microui-kit/use-micro-ui": "^1.1.0",
    "@microui-kit/use-platform-detect": "^1.1.3",
    "@microui-kit/use-theme-mode": "^1.0.0",
    "@microui-kit/with-styles": "^1.1.10",
    "@rc-component/input": "^1.1.1",
    "@rc-component/select": "^1.1.5",
    "@sigmaui-kit/icons": "^0.0.6",
    "@sigmaui-kit/provider": "^0.0.1",
    "@sigmaui-kit/theme-tailwind": "^0.1.1",
    "@sigmaui-kit/use-platform-detect": "^0.0.1",
    "@sigmaui-kit/with-styles": "^0.0.4",
    "@tanstack/react-form": "^1.14.1",
    "@tanstack/react-query": "^5.82.0",
    "@tanstack/react-router": "^1.127.3",
    "@tanstack/react-store": "^0.7.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "classnames": "^2.5.1",
    "fela": "^12.2.1",
    "fela-dom": "^12.2.1",
    "flubber": "^0.4.2",
    "motion": "^12.23.22",
    "query-string": "^9.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-fela": "^12.2.1",
    "react-i18next": "^15.6.0",
    "react-router": "^7.6.3",
    "react-router-dom": "^7.6.3",
    "stylis": "^4.3.6"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@commitlint/cli": "16",
    "@commitlint/config-conventional": "16",
    "@commitlint/prompt": "16",
    "@eslint/js": "^9.15.0",
    "@types/flubber": "^0.4.0",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "clean-package": "^2.2.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.15.0",
    "unplugin-auto-import": "^19.3.0"
  },
  "engines": {
    "node": ">=16.x"
  },
  "type": "module",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/prompt"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,scss,md,mdx,yml,yaml,html,css,scss}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "packageManager": "yarn@1.22.22"
}
